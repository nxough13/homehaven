# ── Database (from Railway) ──────────────────────────────────────────
DB_HOST=your-railway-mysql-host
DB_USER=your-railway-mysql-user
DB_PASSWORD=your-railway-mysql-password
DB_NAME=your-railway-database-name
DB_PORT=3306

# ── Server ───────────────────────────────────────────────────────────
PORT=4000

# ── Auth ─────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-any-long-random-string

# ── Frontend URL (your Vercel deployment URL, used for CORS) ─────────
FRONTEND_URL=https://your-project.vercel.app

# ── Email (not required for portfolio demo) ──────────────────────────
EMAIL_USER=placeholder@gmail.com
EMAIL_PASS=placeholder
